<dashboard version="1.1" theme="light">
  <label>TA-memwatch Metrics</label>
  <description> Index-time metrics over index=metrics (sourcetype memwatch:metrics); series prefixed 'memwatch.'.</description>
  <row>
    <panel type="html">
      <html><![CDATA[<div style="border:1px solid #cc7a00;background:#fff7ea;border-radius:6px;padding:10px 14px;display:flex;flex-wrap:wrap;align-items:center;gap:12px">
<span style="font-weight:700;color:#b35c00">Commercial Use</span>
<span>Commercial or production use of TA-memwatch requires a paid license. Evaluation, personal, and lab use is free. See the BentleyPC Commercial License for full terms.</span>
<a href="https://bentleypc.com/TA-TA-memwatch/" target="_blank" rel="noopener" style="background:#cc7a00;color:#fff;padding:7px 16px;border-radius:5px;font-weight:700;text-decoration:none">Buy License</a>
<a href="https://bentleypc.com/TA-TA-memwatch/LICENSE.html" target="_blank" rel="noopener" style="color:#b35c00;font-weight:600;text-decoration:underline">License &amp; Terms</a>
</div>]]></html>
    </panel>
  </row>
  <row>
    <panel>
      <title>Memory (MB: total / available)</title>
      <chart>
        <search>
          <query>| mstats avg("memwatch.mem_*_mb") as "v*" where index=metrics by metric_name span=5m
| rename v* as "memwatch.mem_*_mb"</query>
          <done/>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.chart.nullValueRendering">connect</option>
        <option name="charting.drilldown">none</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>Percentages (memory available / swap used)</title>
      <chart>
        <search>
          <query>| mstats avg("memwatch.*_pct") as "v*" where index=metrics by metric_name span=5m
| rename v* as "memwatch.*_pct"</query>
          <done/>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.chart.nullValueRendering">connect</option>
        <option name="charting.drilldown">none</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>OOM kills (new per cycle / known total)</title>
      <chart>
        <search>
          <query>| mstats avg("memwatch.oom_*") as "v*" where index=metrics by metric_name span=5m
| rename v* as "memwatch.oom_*"</query>
          <done/>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.chart.nullValueRendering">connect</option>
        <option name="charting.drilldown">none</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>Swap I/O (pages, cumulative)</title>
      <chart>
        <search>
          <query>| mstats avg("memwatch.pswp*") as "v*" where index=metrics by metric_name span=5m
| rename v* as "memwatch.pswp*"</query>
          <done/>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.chart.nullValueRendering">connect</option>
        <option name="charting.drilldown">none</option>
      </chart>
    </panel>
  </row>
</dashboard>
